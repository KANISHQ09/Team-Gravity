# ---------------------------------------------------------------
# GRAVITY — .gitignore
# Stack: pnpm + Turborepo monorepo, TypeScript, Vite, Node.js,
#        Drizzle, Playwright, Docker (see docs/TECH_STACK.md)
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Build outputs
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.vite/
.turbo/
.vercel/
.cache/

# Environment variables and secrets (document them in .env.example)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Tests and coverage
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.lighthouseci/

# Local databases and data dumps
*.sqlite
*.sqlite3
*.db
*.dump
pgdata/
docker-data/

# GMAT local runs (keep scripts and curated exports, not raw output)
tools/gmat/output/

# Editors and IDEs (shared settings may be committed explicitly)
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Operating systems
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Office lock files (e.g. resources/*.docx open in Word)
~$*

# Claude Code: personal local settings only (shared CLAUDE.md and
# .claude/settings.json are committed)
.claude/settings.local.json
CLAUDE.local.md

# Misc
*.tgz
.eslintcache
.stylelintcache
