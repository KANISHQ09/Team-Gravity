# ---------------------------------------------------------------
# GRAVITY environment variables
# Copy to .env (git-ignored) and adjust. NEVER commit real secrets.
# Values below are for LOCAL development only (docker-compose.yml).
# ---------------------------------------------------------------

# --- Server (apps/server) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Web app origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# --- Database: PostgreSQL 16 (local Docker; Neon in staging/production) ---
DATABASE_URL=postgres://gravity:gravity@localhost:5432/gravity

# --- Redis (local Docker; Upstash in staging/production) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Optional until auth is implemented (empty = not set). When set, at least
# 32 characters. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SIGNING_KEY=

# --- Web app (apps/web reads this root .env); only VITE_* variables reach the browser ---
VITE_API_URL=http://localhost:3000

# --- Monitoring (enable later) ---
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=

# --- Post-MVP ---
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# NASA_API_KEY=
# ANTHROPIC_API_KEY=
